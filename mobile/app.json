{
  "expo": {
    "name": "ConvoReal",
    "slug": "convoreal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "convoreal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.convoreal.app",
      "associatedDomains": [
        "applinks:convoreal.com",
        "applinks:www.convoreal.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.convoreal.app"
        ]
      }
    },
    "android": {
      "package": "com.convoreal.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1F16"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/inventory"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/pipelines"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/contacts"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/calendar"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/journey"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/broadcasts"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/settings"
            },
            {
              "scheme": "https",
              "host": "www.convoreal.com",
              "pathPrefix": "/dashboard"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ConvoReal uses your location to find property listings near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A1F16",
          "dark": {
            "backgroundColor": "#0A1F16"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ConvoReal imports contacts you choose into your CRM."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ConvoReal adds photos you choose to your property listings.",
          "cameraPermission": "ConvoReal uses the camera to add photos to your property listings."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ConvoReal uses Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A1F16"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ConvoReal uses the microphone so you can schedule appointments by voice."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Inbox",
              "label": "Inbox",
              "description": "Unread and open WhatsApp chats",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Calendar",
              "label": "Calendar",
              "description": "Today's appointments at a glance",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Contacts",
              "label": "Contacts",
              "description": "Your book of leads and hot prospects",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Properties",
              "label": "Properties",
              "description": "Available listings in your inventory",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Deals",
              "label": "Deals",
              "description": "Open pipeline value and deal count",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Broadcasts",
              "label": "Broadcasts",
              "description": "Delivery of your latest campaign",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35ac40bb-d476-4b1f-ae5f-139b38e409dd"
      }
    },
    "owner": "praneethpvrealtys-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/35ac40bb-d476-4b1f-ae5f-139b38e409dd"
    }
  }
}
