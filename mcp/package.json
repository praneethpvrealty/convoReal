{
  "name": "convoreal-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing a ConvoReal workspace — inventory, contacts, matching, pipeline and agenda — to MCP clients.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "convoreal-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
