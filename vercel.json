{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!go-ingress' ':!docs' ':!Dockerfile.worker' ':!mobile' ':!mcp'",
  "buildCommand": "NEXT_PUBLIC_BUILD_ID=$(git rev-parse --short HEAD) next build",
  "crons": [
    {
      "path": "/api/cron/realtime-publication-check",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-images",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/market-stats",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/follow-up-nudges",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/owner-digest",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/agent-inventory-digest",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/deal-mode-matching",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/buyer-match-digest",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/den-bids-expiry",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/agent-task-digest",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/conversation-sweep",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/lead-sync-reconcile",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/outreach-followups",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/appointments/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/location-request-timeouts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/broadcast-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/voice-campaigns",
      "schedule": "*/10 * * * *"
    }
  ]
}
